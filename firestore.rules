rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "biorinsanos@gmail.com" ||
        request.auth.token.email == "suporte.cortesa@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /bonde_1000/{participantId} {
      allow get: if isValidId(participantId);
      allow create: if isValidId(participantId) && isValidParticipant(incoming());
      allow list, update, delete: if isAdmin();
    }

    function isValidParticipant(data) {
      return data.keys().hasAll(['nome', 'nomeColete', 'regional', 'divisao', 'grau', 'evento', 'dataEvento', 'horarioSaida', 'localConcentracao', 'dataHoraConfirmacao']) &&
             data.keys().hasOnly(['nome', 'nomeColete', 'regional', 'divisao', 'grau', 'evento', 'dataEvento', 'horarioSaida', 'localConcentracao', 'dataHoraConfirmacao', 'lookupKey', 'createdAt', 'tipoParticipante', 'motoclube', 'cargoFuncao', 'comandoInternacional', 'comandoPasta']) &&
             data.nome is string && data.nome.size() >= 2 && data.nome.size() <= 100 &&
             data.nomeColete is string && data.nomeColete.size() <= 100 &&
             data.regional is string && data.regional.size() <= 100 &&
             data.divisao is string && data.divisao.size() <= 100 &&
             data.grau is string && data.grau.size() <= 50 &&
             data.evento == '1º Bonde das 1000 Motos' &&
             data.dataEvento == '10/10/2026' &&
             data.horarioSaida == '10:00' &&
             (data.localConcentracao == 'PE Avenida Deputado Aníbal Khury' || data.localConcentracao == 'PE Deputado Aníbal Khury') &&
             (!('tipoParticipante' in data) || (data.tipoParticipante is string && data.tipoParticipante.size() <= 50)) &&
             (!('motoclube' in data) || (data.motoclube is string && data.motoclube.size() <= 100)) &&
             (!('cargoFuncao' in data) || (data.cargoFuncao is string && data.cargoFuncao.size() <= 100)) &&
             (!('comandoInternacional' in data) || (data.comandoInternacional is string && data.comandoInternacional.size() <= 150)) &&
             (!('comandoPasta' in data) || (data.comandoPasta is string && data.comandoPasta.size() <= 150));
    }
  }
}
